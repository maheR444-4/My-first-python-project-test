import pygame
import random

pygame.init()

WIDTH = 600
HEIGHT = 700

screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Meteor Dodge")

clock = pygame.time.Clock()

# رنگ‌ها
BLACK = (10, 10, 25)
WHITE = (255, 255, 255)
BLUE = (40, 140, 255)
RED = (220, 50, 50)
ORANGE = (255, 150, 40)
GRAY = (60, 60, 80)

# بازیکن
player = pygame.Rect(275, 580, 50, 50)
player_speed = 7

# شهاب‌سنگ‌ها
meteors = []
meteor_speed = 5

# امتیاز
score = 0
font = pygame.font.Font(None, 40)
big_font = pygame.font.Font(None, 70)

spawn_timer = 0

game_over = False
running = True

# دکمه‌های موبایل
left_button = pygame.Rect(30, 610, 110, 70)
right_button = pygame.Rect(460, 610, 110, 70)


def restart_game():
    global score, meteor_speed, game_over, spawn_timer

    player.x = WIDTH // 2 - 25
    player.y = 500

    meteors.clear()

    score = 0
    meteor_speed = 5
    spawn_timer = 0

    game_over = False


while running:

    # وضعیت لمس
    touch_left = False
    touch_right = False

    for event in pygame.event.get():

        if event.type == pygame.QUIT:
            running = False

        # کیبورد
        if event.type == pygame.KEYDOWN:

            if event.key == pygame.K_r and game_over:
                restart_game()

        # لمس موبایل
        if event.type == pygame.FINGERDOWN:
            x = event.x * WIDTH
            y = event.y * HEIGHT

            if left_button.collidepoint(x, y):
                touch_left = True

            if right_button.collidepoint(x, y):
                touch_right = True

            # اگر باختیم و وسط صفحه را لمس کردیم
            if game_over:
                restart_game()

        if event.type == pygame.FINGERUP:
            touch_left = False
            touch_right = False

    if not game_over:

        # کنترل کامپیوتر
        keys = pygame.key.get_pressed()

        moving_left = keys[pygame.K_LEFT] or touch_left
        moving_right = keys[pygame.K_RIGHT] or touch_right

        # حرکت
        if moving_left:
            player.x -= player_speed

        if moving_right:
            player.x += player_speed

        # محدود کردن بازیکن
        if player.left < 0:
            player.left = 0

        if player.right > WIDTH:
            player.right = WIDTH

        # ساخت شهاب‌سنگ
        spawn_timer += 1

        if spawn_timer >= 30:
            spawn_timer = 0

            x = random.randint(0, WIDTH - 40)

            meteor = pygame.Rect(
                x,
                -40,
                40,
                40
            )

            meteors.append(meteor)

        # حرکت شهاب‌سنگ‌ها
        for meteor in meteors[:]:

            meteor.y += meteor_speed

            # خارج شدن از صفحه
            if meteor.top > HEIGHT:
                meteors.remove(meteor)
                score += 1

            # برخورد
            elif player.colliderect(meteor):
                game_over = True

        # سخت‌تر شدن بازی
        meteor_speed = 5 + score // 10

    # -------------------------
    # رسم صفحه
    # -------------------------

    screen.fill(BLACK)

    # ستاره‌ها
    for i in range(50):

        x = (i * 97) % WIDTH
        y = (i * 53) % HEIGHT

        pygame.draw.circle(
            screen,
            WHITE,
            (x, y),
            2
        )

    # بازیکن
    pygame.draw.rect(
        screen,
        BLUE,
        player,
        border_radius=10
    )

    pygame.draw.rect(
        screen,
        WHITE,
        player,
        3,
        border_radius=10
    )

    # شهاب‌سنگ‌ها
    for meteor in meteors:

        pygame.draw.circle(
            screen,
            ORANGE,
            meteor.center,
            20
        )

        pygame.draw.circle(
            screen,
            RED,
            meteor.center,
            12
        )

    # امتیاز
    score_text = font.render(
        f"Score: {score}",
        True,
        WHITE
    )

    screen.blit(
        score_text,
        (20, 20)
    )

    # -------------------------
    # دکمه‌های موبایل
    # -------------------------

    pygame.draw.rect(
        screen,
        GRAY,
        left_button,
        border_radius=15
    )

    pygame.draw.rect(
        screen,
        GRAY,
        right_button,
        border_radius=15
    )

    left_text = big_font.render(
        "◀",
        True,
        WHITE
    )

    right_text = big_font.render(
        "▶",
        True,
        WHITE
    )

    screen.blit(
        left_text,
        (
            left_button.centerx - left_text.get_width() // 2,
            left_button.centery - left_text.get_height() // 2
        )
    )

    screen.blit(
        right_text,
        (
            right_button.centerx - right_text.get_width() // 2,
            right_button.centery - right_text.get_height() // 2
        )
    )

    # -------------------------
    # Game Over
    # -------------------------

    if game_over:

        game_over_text = big_font.render(
            "GAME OVER",
            True,
            RED
        )

        restart_text = font.render(
            "Press R or Touch Screen",
            True,
            WHITE
        )

        screen.blit(
            game_over_text,
            (
                WIDTH // 2 -
                game_over_text.get_width() // 2,
                270
            )
        )

        screen.blit(
            restart_text,
            (
                WIDTH // 2 -
                restart_text.get_width() // 2,
                350
            )
        )

    pygame.display.update()

    clock.tick(60)


pygame.quit()