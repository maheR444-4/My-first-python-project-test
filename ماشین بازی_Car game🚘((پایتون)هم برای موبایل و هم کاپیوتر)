import pygame
import random
import sys

pygame.init()

# =========================
# تنظیمات بازی
# =========================

WIDTH = 500
HEIGHT = 700

screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Neon Road")

clock = pygame.time.Clock()

# =========================
# رنگ‌ها
# =========================

BLACK = (10, 10, 25)
WHITE = (255, 255, 255)
BLUE = (40, 180, 255)
RED = (255, 60, 80)
YELLOW = (255, 220, 50)
GRAY = (65, 65, 75)
GREEN = (50, 220, 120)

# =========================
# فونت
# =========================

font = pygame.font.Font(None, 40)
big_font = pygame.font.Font(None, 70)

# =========================
# بازیکن
# =========================

player = pygame.Rect(
    WIDTH // 2 - 25,
    HEIGHT - 110,
    50,
    70
)

player_speed = 7

# =========================
# موانع
# =========================

obstacles = []

obstacle_speed = 5
spawn_timer = 0

# =========================
# امتیاز
# =========================

score = 0
game_over = False


# =========================
# ساخت مانع
# =========================

def create_obstacle():

    x = random.randint(
        70,
        WIDTH - 120
    )

    obstacle = pygame.Rect(
        x,
        -80,
        50,
        70
    )

    obstacles.append(obstacle)


# =========================
# رسم ماشین
# =========================

def draw_player():

    # بدنه
    pygame.draw.rect(
        screen,
        BLUE,
        player,
        border_radius=10
    )

    # شیشه
    pygame.draw.rect(
        screen,
        (100, 220, 255),
        (
            player.x + 10,
            player.y + 12,
            30,
            20
        ),
        border_radius=5
    )

    # چراغ‌ها
    pygame.draw.rect(
        screen,
        YELLOW,
        (
            player.x + 7,
            player.y + 4,
            10,
            7
        ),
        border_radius=2
    )

    pygame.draw.rect(
        screen,
        YELLOW,
        (
            player.x + 33,
            player.y + 4,
            10,
            7
        ),
        border_radius=2
    )


# =========================
# شروع دوباره
# =========================

def restart():

    global score
    global obstacles
    global obstacle_speed
    global spawn_timer
    global game_over

    player.x = WIDTH // 2 - 25
    player.y = HEIGHT - 110

    obstacles.clear()

    score = 0

    obstacle_speed = 5

    spawn_timer = 0

    game_over = False


# =========================
# حلقه اصلی بازی
# =========================

while True:

    # =====================
    # رویدادها
    # =====================

    for event in pygame.event.get():

        # خروج
        if event.type == pygame.QUIT:

            pygame.quit()
            sys.exit()

        # -----------------
        # لمس موبایل / کلیک
        # -----------------

        if event.type == pygame.MOUSEBUTTONDOWN:

            # اگر باخته‌ای
            if game_over:

                restart()

            # اگر بازی در حال اجراست
            else:

                # لمس سمت چپ
                if event.pos[0] < WIDTH // 2:

                    player.x -= 80

                # لمس سمت راست
                else:

                    player.x += 80

        # -----------------
        # کیبورد کامپیوتر
        # -----------------

        if event.type == pygame.KEYDOWN:

            if game_over:

                if event.key == pygame.K_r:

                    restart()

    # =====================
    # کنترل کیبورد
    # =====================

    keys = pygame.key.get_pressed()

    if not game_over:

        if keys[pygame.K_LEFT] or keys[pygame.K_a]:

            player.x -= player_speed

        if keys[pygame.K_RIGHT] or keys[pygame.K_d]:

            player.x += player_speed

    # =====================
    # محدود کردن بازیکن
    # =====================

    if player.left < 55:

        player.left = 55

    if player.right > WIDTH - 55:

        player.right = WIDTH - 55

    # =====================
    # آپدیت بازی
    # =====================

    if not game_over:

        spawn_timer += 1

        # ساخت مانع
        if spawn_timer >= 45:

            create_obstacle()

            spawn_timer = 0

        # حرکت موانع
        for obstacle in obstacles:

            obstacle.y += obstacle_speed

        # بررسی موانع
        for obstacle in obstacles[:]:

            # خارج شدن از صفحه
            if obstacle.top > HEIGHT:

                obstacles.remove(obstacle)

                score += 1

                # سخت‌تر شدن بازی
                if score % 10 == 0:

                    obstacle_speed += 0.5

            # برخورد
            elif player.colliderect(obstacle):

                game_over = True

    # =====================
    # رسم پس‌زمینه
    # =====================

    screen.fill(BLACK)

    # جاده
    pygame.draw.rect(
        screen,
        GRAY,
        (
            55,
            0,
            WIDTH - 110,
            HEIGHT
        )
    )

    # حاشیه جاده
    pygame.draw.rect(
        screen,
        GREEN,
        (
            55,
            0,
            5,
            HEIGHT
        )
    )

    pygame.draw.rect(
        screen,
        GREEN,
        (
            WIDTH - 60,
            0,
            5,
            HEIGHT
        )
    )

    # =====================
    # خطوط وسط جاده
    # =====================

    for y in range(0, HEIGHT, 90):

        pygame.draw.rect(
            screen,
            WHITE,
            (
                WIDTH // 2 - 5,
                y,
                10,
                45
            )
        )

    # =====================
    # رسم موانع
    # =====================

    for obstacle in obstacles:

        pygame.draw.rect(
            screen,
            RED,
            obstacle,
            border_radius=10
        )

        # علامت روی مانع
        pygame.draw.line(
            screen,
            YELLOW,
            (
                obstacle.x + 10,
                obstacle.y + 10
            ),
            (
                obstacle.x + 40,
                obstacle.y + 60
            ),
            5
        )

        pygame.draw.line(
            screen,
            YELLOW,
            (
                obstacle.x + 40,
                obstacle.y + 10
            ),
            (
                obstacle.x + 10,
                obstacle.y + 60
            ),
            5
        )

    # =====================
    # رسم بازیکن
    # =====================

    draw_player()

    # =====================
    # امتیاز
    # =====================

    score_text = font.render(
        "Score: " + str(score),
        True,
        WHITE
    )

    screen.blit(
        score_text,
        (15, 15)
    )

    # =====================
    # صفحه باخت
    # =====================

    if game_over:

        # صفحه نیمه شفاف
        overlay = pygame.Surface(
            (WIDTH, HEIGHT)
        )

        overlay.set_alpha(180)

        overlay.fill(BLACK)

        screen.blit(
            overlay,
            (0, 0)
        )

        # GAME OVER
        game_over_text = big_font.render(
            "GAME OVER",
            True,
            RED
        )

        screen.blit(
            game_over_text,
            (
                WIDTH // 2 -
                game_over_text.get_width() // 2,
                HEIGHT // 2 - 100
            )
        )

        # امتیاز
        final_score = font.render(
            "Score: " + str(score),
            True,
            WHITE
        )

        screen.blit(
            final_score,
            (
                WIDTH // 2 -
                final_score.get_width() // 2,
                HEIGHT // 2
            )
        )

        # موبایل
        touch_text = font.render(
            "Tap to restart",
            True,
            YELLOW
        )

        screen.blit(
            touch_text,
            (
                WIDTH // 2 -
                touch_text.get_width() // 2,
                HEIGHT // 2 + 60
            )
        )

        # کامپیوتر
        keyboard_text = pygame.font.Font(
            None,
            28
        ).render(
            "Press R",
            True,
            WHITE
        )

        screen.blit(
            keyboard_text,
            (
                WIDTH // 2 -
                keyboard_text.get_width() // 2,
                HEIGHT // 2 + 105
            )
        )

    # =====================
    # نمایش
    # =====================

    pygame.display.flip()

    # 60 FPS
    clock.tick(60)