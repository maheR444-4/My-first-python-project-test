import pygame
import random

pygame.init()

# اندازه صفحه گوشی
WIDTH = 720
HEIGHT = 1280

screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Snake")

clock = pygame.time.Clock()

# رنگ‌ها
BLACK = (20, 20, 20)
GREEN = (0, 220, 80)
DARK_GREEN = (0, 150, 50)
RED = (240, 50, 50)
WHITE = (255, 255, 255)
GRAY = (70, 70, 70)

# اندازه هر قسمت مار
BLOCK = 30

# شروع مار
snake = [
    (360, 300),
    (330, 300),
    (300, 300)
]

direction = (BLOCK, 0)

# ساخت غذا
def new_food():
    return (
        random.randrange(0, WIDTH, BLOCK),
        random.randrange(0, 800, BLOCK)
    )

food = new_food()

score = 0
game_over = False


# دکمه‌ها
up_button = pygame.Rect(310, 900, 100, 100)
down_button = pygame.Rect(310, 1120, 100, 100)
left_button = pygame.Rect(190, 1010, 100, 100)
right_button = pygame.Rect(430, 1010, 100, 100)


def change_direction(new_direction):

    global direction

    # جلوگیری از برگشت مستقیم
    if (
        new_direction[0] != -direction[0]
        or new_direction[1] != -direction[1]
    ):
        direction = new_direction


running = True

while running:

    # دریافت لمس و خروج
    for event in pygame.event.get():

        if event.type == pygame.QUIT:
            running = False

        if event.type == pygame.MOUSEBUTTONDOWN:

            x, y = event.pos

            if up_button.collidepoint(x, y):
                change_direction((0, -BLOCK))

            elif down_button.collidepoint(x, y):
                change_direction((0, BLOCK))

            elif left_button.collidepoint(x, y):
                change_direction((-BLOCK, 0))

            elif right_button.collidepoint(x, y):
                change_direction((BLOCK, 0))

    if not game_over:

        # حرکت مار
        head_x, head_y = snake[0]
        dx, dy = direction

        new_head = (
            head_x + dx,
            head_y + dy
        )

        # برخورد با دیوار
        if (
            new_head[0] < 0
            or new_head[0] >= WIDTH
            or new_head[1] < 0
            or new_head[1] >= 800
        ):
            game_over = True

        # برخورد با خودش
        if new_head in snake:
            game_over = True

        snake.insert(0, new_head)

        # خوردن غذا
        if new_head == food:

            score += 1
            food = new_food()

        else:
            snake.pop()

    # پاک کردن صفحه
    screen.fill(BLACK)

    # مار
    for i, part in enumerate(snake):

        color = GREEN if i == 0 else DARK_GREEN

        pygame.draw.rect(
            screen,
            color,
            (part[0], part[1], BLOCK, BLOCK)
        )

    # غذا
    pygame.draw.rect(
        screen,
        RED,
        (food[0], food[1], BLOCK, BLOCK)
    )

    # امتیاز
    font = pygame.font.SysFont(None, 50)

    score_text = font.render(
        "Score: " + str(score),
        True,
        WHITE
    )

    screen.blit(score_text, (20, 20))

    # دکمه‌ها
    pygame.draw.rect(screen, GRAY, up_button)
    pygame.draw.rect(screen, GRAY, down_button)
    pygame.draw.rect(screen, GRAY, left_button)
    pygame.draw.rect(screen, GRAY, right_button)

    # فلش‌ها
    arrow_font = pygame.font.SysFont(None, 70)

    up_text = arrow_font.render("↑", True, WHITE)
    down_text = arrow_font.render("↓", True, WHITE)
    left_text = arrow_font.render("←", True, WHITE)
    right_text = arrow_font.render("→", True, WHITE)

    screen.blit(up_text, (340, 915))
    screen.blit(down_text, (340, 1135))
    screen.blit(left_text, (215, 1025))
    screen.blit(right_text, (455, 1025))

    # Game Over
    if game_over:

        big_font = pygame.font.SysFont(None, 90)

        game_text = big_font.render(
            "GAME OVER",
            True,
            RED
        )

        screen.blit(
            game_text,
            (210, 400)
        )

    pygame.display.update()

    clock.tick(10)

pygame.quit()
